# Use env-specific files:
#   .env.dev  → LienNavigator-jobs-dev
#   .env.prod → LienNavigator-jobs-prod
#
# Copy .env.dev / .env.prod, fill keys, paste into that Lambda's console env.
# Do not commit filled files.

MONGODB_URI=
API2PDF_KEY=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1

JOBS_ARTIFACT_BUCKET=liennavigator-private-bucket
JOBS_ARTIFACT_PREFIX=LienNavigator/jobs/dev
